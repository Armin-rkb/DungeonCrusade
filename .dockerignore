dist
dist-server
dist-electron
public/gen
test-results
*.log

# Native wrappers and their generated projects
platforms
android
ios
capacitor.config.ts

# Unity editor state that the web build never reads
Library
Temp
Obj
Build
Builds
Logs
UserSettings

# Deployment files themselves
Dockerfile
.dockerignore
fly.toml
