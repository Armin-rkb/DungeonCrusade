# Docker build context: the web client sources, server, tools and the original
# Unity Assets (the asset pipeline regenerates public/gen inside the image).

# VCS / CI / editor
.git
.github
.vscode
.idea

# Dependencies and build output (rebuilt in the image)
node_modules
