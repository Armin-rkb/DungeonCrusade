{
  "name": "dungeon-crusade-desktop",
  "productName": "Dungeon Crusade",
  "version": "2.0.0",
  "private": true,
  "description": "Dungeon Crusade desktop / Steam build (Electron shell around the web build).",
  "author": "Ferry Elbaghdadi and Armin Karimi Birgani",
  "homepage": "https://dungeon-crusade.fly.dev/",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "prepare:web": "node scripts/prepare-web.mjs",
    "pack": "npm run prepare:web && electron-builder --dir --publish never",
    "dist": "npm run prepare:web && electron-builder --publish never",
    "dist:win": "npm run prepare:web && electron-builder --win --publish never",
    "dist:mac": "npm run prepare:web && electron-builder --mac --publish never",
    "dist:linux": "npm run prepare:web && electron-builder --linux --publish never",
    "typecheck": "tsc -p tsconfig.json",
    "check": "node --check main.cjs && node --check preload.cjs && node --check electron-builder.cjs && node --check scripts/prepare-web.mjs && tsc -p tsconfig.json"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3"
  }
}
