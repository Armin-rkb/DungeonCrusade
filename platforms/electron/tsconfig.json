{
  // Type-checks the plain JS sources against the Electron and steamworks.js
  // typings (`npm run typecheck`). Nothing is emitted.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["main.cjs", "preload.cjs", "electron-builder.cjs", "scripts/*.mjs"]
}
